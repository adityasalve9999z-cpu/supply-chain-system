{
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Core Launch (web)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/SupplyChain/SupplyChainSystem.API/bin/Debug/net10.0/SupplyChainSystem.API.dll",
            "args": [
                "--urls",
                "http://localhost:5219"
            ],
            "cwd": "${workspaceFolder}/SupplyChain/SupplyChainSystem.API",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        },
        {
            "name": "Flowline Frontend",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run dev -- --host localhost --port 5173",
            "cwd": "${workspaceFolder}/frontend",
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "Local:\\s+(http://localhost:\\d+)"
            }
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        }
    ],
    "compounds": [
        {
            "name": "Flowline Full Stack",
            "configurations": [
                ".NET Core Launch (web)",
                "Flowline Frontend"
            ],
            "stopAll": true
        }
    ]
}
